<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Learning Statistics"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="24dp"/>
        
    <!-- Circular Progress -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Overall Course Progress"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>
        
    <com.app.learning.ui.customview.ProgressDashboardView
        android:id="@+id/progressDashboardView"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Heatmap Calendar Placeholder -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activity Heatmap"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>
        
    <!-- In a real app you might use a GridLayout or RecyclerView for the heatmap squares -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="[ GitHub Style Heatmap Calendar ]"/>
    </FrameLayout>

    <!-- Bar Chart Placeholder -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Weekly Learning Hours"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>
        
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#E0E0E0">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="[ Bar Chart Component ]"/>
    </FrameLayout>

</LinearLayout>
