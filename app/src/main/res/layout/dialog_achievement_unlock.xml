<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:gravity="center"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUnlockContainer"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUY HIỆU MỚI MỞ KHÓA! 🎉"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:id="@+id/imgBadgeGlow"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_star"
                android:contentDescription="Badge Graphic"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvAchievementTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bậc Thầy Trắc Nghiệm"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAchievementDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đạt 100% điểm trong 5 quiz liên tiếp"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCelebrate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Tuyệt vời!"
                android:textSize="16sp"
                app:cornerRadius="24dp"
                app:backgroundTint="#F59E0B" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
