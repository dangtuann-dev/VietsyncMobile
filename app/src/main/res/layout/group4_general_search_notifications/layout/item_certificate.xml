<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="16dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgBadge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_badge"
            app:tint="#F59E0B"
            android:contentDescription="Certificate icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvCourseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lập trình Android MVVM"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvIssuedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngày cấp: 2026-07-22"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewCertificate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xem"
            style="@style/Widget.Material3.Button.TonalButton"
            android:textColor="#3B82F6"
            app:cornerRadius="8dp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
