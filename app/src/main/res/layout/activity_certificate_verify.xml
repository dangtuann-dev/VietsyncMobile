<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E293B"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@android:color/white"
        app:title="Xác Minh Chứng Chỉ"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- QR Scanner Simulation Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="16dp"
                app:strokeColor="#F59E0B"
                app:strokeWidth="2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <View
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:background="@drawable/bg_dialog_rounded"
                        android:backgroundTint="#2A3B56" />

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_camera"
                        app:tint="#F59E0B"
                        android:layout_centerInParent="true"
                        android:contentDescription="Camera Preview Placeholder" />

                    <!-- Scanning laser simulation line -->
                    <View
                        android:layout_width="220dp"
                        android:layout_height="2dp"
                        android:background="#EF4444"
                        android:layout_centerInParent="true" />
                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đưa mã QR vào khung để quét"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Chọn ảnh từ Thư viện"
                android:textColor="#3B82F6"
                app:strokeColor="#3B82F6"
                android:layout_marginBottom="16dp"
                app:cornerRadius="8dp" />

            <!-- Manual ID Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCertId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    app:boxBackgroundColor="#1E293B"
                    app:boxStrokeColor="#334155"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:hintTextColor="#94A3B8"
                    android:textColorHint="#94A3B8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCertId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Hoặc nhập mã chứng chỉ"
                        android:textColor="@android:color/white"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerify"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Xác minh"
                    android:backgroundTint="#3B82F6"
                    android:textColor="@android:color/white"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Verification Result Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="12dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvStatusHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CHỨNG CHỈ HỢP LỆ"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Học viên: Nguyễn Văn A"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvCourseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Khóa học: Lập trình Android"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvInstructor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Giảng viên: Giảng viên Vietsync"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvIssuedDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ngày cấp: 2026-07-28"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
