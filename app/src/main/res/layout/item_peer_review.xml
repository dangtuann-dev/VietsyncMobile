<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvReviewerAlias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Người Đánh Giá #1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <RatingBar
                android:id="@+id/rbAverage"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:isIndicator="true"
                android:rating="4.5" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bài làm đầy đủ chi tiết và đúng tiêu chí bài nộp."
            android:textSize="13sp"
            android:textColor="#334155" />

        <TextView
            android:id="@+id/tvReviewDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="2026-07-30 09:15"
            android:textSize="11sp"
            android:textColor="#94A3B8" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
